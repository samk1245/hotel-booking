# ==========================================
# XYZ HOTEL - ENVIRONMENT CONFIG
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Private Admin Portal Route (Keep discreet)
ADMIN_PATH=/private-management

# Security & Session Secrets
JWT_SECRET=xyz-luxury-hotel-super-secret-key-2026-production

# Database (Optional for dev: automatically falls back to embedded store.json if left blank or unreachable)
MONGODB_URI=mongodb://127.0.0.1:27017/xyz_hotel

# Transactional Email Service (Optional for dev: logs email preview in console if blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=concierge@xyzhotel.com
NOTIFICATION_EMAIL=reservations@xyzhotel.com
