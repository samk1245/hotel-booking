PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Admin Portal Configuration (Configurable route to keep URL discreet)
ADMIN_PATH=/private-management

# Database (Optional for dev: if left blank or unreachable, falls back to embedded store.json)
MONGODB_URI=mongodb://127.0.0.1:27017/xyz_hotel

# Security Secrets
JWT_SECRET=xyz-luxury-hotel-super-secret-key-2026-production

# Email Service (Optional: leave blank in dev to preview emails in console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=concierge@xyzhotel.com
NOTIFICATION_EMAIL=reservations@xyzhotel.com
